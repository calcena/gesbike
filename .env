# .env (local)
APP_ENV=local
APP_VERSION=1.0-0
APP_NAME=Mantenimientos bicicletas
DB_TYPE=sqlite
DB_PATH=../../database/app.db
VOICE_DB_PATH=../../database/comandos_voz.db
FTP_HOST=ftpupload.net
FTP_PORT=21
FTP_USER=if0_40253663
FTP_PASS=sUCsOHy0DF
FTP_PASSIVE=true
FTP_PENDING_DIR=/htdocs/pending_uploads/
# Directorio de pendientes. Acepta ruta ABSOLUTA o RELATIVA al raiz de la app.
# Usar RELATIVA en hostings con chroot FTP (InfinityFree): "pending_uploads"
# resuelve a <webroot>/pending_uploads, que es el FTP /htdocs/pending_uploads.
# NO usar "/htdocs/..." absoluta: esa ruta la ve el FTP, no el filesystem de PHP.
PENDING_UPLOADS_PATH=pending_uploads
